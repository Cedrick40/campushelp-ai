# Frontend environment configuration.
#
# Copy this file to `frontend/.env` and adjust. `.env` is gitignored, so no
# address or key is ever committed. Vite only exposes variables prefixed with
# VITE_ to the browser.

# Address of the CampusHelp AI backend (Django).
# Leave empty to call the backend on the same origin (e.g. behind a proxy).
VITE_API_BASE_URL=http://localhost:8000

# true  -> answers come from src/mockApi.js, no backend needed (UI development)
# false -> answers come from the real Django API
VITE_USE_MOCK=false

# Milliseconds before a request is treated as failed.
VITE_REQUEST_TIMEOUT_MS=30000
