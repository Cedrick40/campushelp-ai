# Production builds call /proxy-api on the same origin. Vercel proxies those
# requests to the Django backend's /api (see frontend/vercel.json), so the
# browser never makes a cross-origin request and CORS cannot block the app.
VITE_API_SAME_ORIGIN=true
VITE_USE_MOCK=false

# Render's free web services spin down when idle; the first request can take
# longer than the development timeout.
VITE_REQUEST_TIMEOUT_MS=90000
