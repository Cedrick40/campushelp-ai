# Local development (copy to backend/.env)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
FRONTEND_ORIGIN=http://localhost:5173
AI_API_KEY=your-key-here

# Production values (set these in your host's environment settings, not here)
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<a long random value>
# DJANGO_ALLOWED_HOSTS=your-api.onrender.com
# DATABASE_URL=postgresql://user:password@host:5432/database
# FRONTEND_ORIGINS=https://your-frontend.vercel.app
# Optional: also allow Vercel preview URLs (they change on every deploy)
# FRONTEND_ORIGIN_REGEXES=^https://your-project-.*\.vercel\.app$
# CORS_ALLOW_ALL_ORIGINS=false
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app
